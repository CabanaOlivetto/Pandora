// Controladores do diálogo
exibir_dialogo = true; // Começa true para iniciar a cena imediatamente
indice_fala = 0;       // Controla qual frase está passando
distancia_interacao = 40;

// Lista com todas as falas do diálogo
dialogo[0] = "Atendente: O de sempre, Morvian?";
dialogo[1] = "Morvian: (Sim...)";
dialogo[2] = "Narrador: Você ergue os olhos... e congela. O atendente é você.";
dialogo[3] = "Atendente: Você ainda vem aqui quando tudo pesa demais.";
dialogo[4] = "Narrador: Silêncio. O ambiente parece mais quente.";
dialogo[5] = "Atendente: Você se cobrou tanto, Morvian. Por tanto tempo.";
dialogo[6] = "Narrador: Ele desliza o pedido pelo balcão, devagar.";
dialogo[7] = "Atendente: Mas olha só. Você ainda está aqui.";
dialogo[8] = "Narrador: Uma pausa longa.";
dialogo[9] = "Atendente: E desta vez... você não parece fugir.";